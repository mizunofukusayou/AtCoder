{
    "configurations": [
        {
            "name": "lldb: デバッグ実行",
            "preLaunchTask": "clang++ デバッグ用コンパイル",
            "type": "lldb",
            "request": "launch",
            "program": "${fileDirname}/a.out",
            "args": [],
            "env": {
                "UBSAN_OPTIONS": "abort_on_error=1:print_stacktrace=1",
                "ASAN_OPTIONS": "abort_on_error=1:detect_leaks=0"
            },
            "cwd": "${fileDirname}"
        }
    ],
    "version": "2.0.0"
}
